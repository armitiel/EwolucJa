# Ewolucja — Konfiguracja backendu
# Skopiuj ten plik do .env i uzupełnij wartości.

# ── Anthropic Claude API ─────────────────────────────────────────────
# Klucz API Anthropic — wymagany do pełnej funkcjonalności agentów AI
# (NarratorAgent, ProfilerAgent, ReportAgent, generowanie misji).
# Bez klucza agenci działają w trybie demo (fallback z gotowymi odpowiedziami).
ANTHROPIC_API_KEY=sk-ant-xxx

# ── ElevenLabs TTS ───────────────────────────────────────────────────
# Klucz API ElevenLabs — wymagany do głosu narratora GAMA-1 i Mentora.
# Bez klucza frontend automatycznie spada na Web Speech API (wbudowany TTS przeglądarki).
# Klucz znajdziesz w: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ID głosu narratora GAMA-1 (kobiecy, ciepły, lekko tajemniczy).
# Domyślne ID jest ustawione w kodzie — nadpisz, jeśli chcesz inny głos.
ELEVENLABS_VOICE_ID=XrYxa2QP5oFX1cg3JPdt

# ID głosu Mentora (rodzic/nauczyciel, niższy/cieplejszy, odróżnialny od narratora).
# Jeśli puste — użyje tego samego co narrator.
ELEVENLABS_MENTOR_VOICE_ID=

# Model TTS — eleven_flash_v2_5 jest szybki i tani, eleven_multilingual_v2 ma lepszą jakość.
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── Server ───────────────────────────────────────────────────────────
# Port serwera (domyślnie 3001)
PORT=3001

# ── Sentry ─────────────────────────────────────────────────────────────────
# DSN projektu `ewolucja-backend` (organizacja `armitiel`, region DE).
# Puste = SDK wyłączone: lokalny `npm run dev` nie wysyła żadnych zdarzeń.
# Produkcja bierze tę wartość ze zmiennych środowiskowych Vercela, nie stąd.
SENTRY_DSN=
