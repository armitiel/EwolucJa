  "responsive": {
    "desktopHubWidth": 480,
    "desktopHubBreakpoint": 520,
    "compactBreakpoint": 360,
    "bubbleHorizontalMargin": "8-12px",
    "safeArea": true,
    "dynamicViewport": true
  }
