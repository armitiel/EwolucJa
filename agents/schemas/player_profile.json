{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlayerProfile",
  "description": "Profil gracza GAMA-1 V2 — archetyp, scoring 6 kompetencji, cykl tygodniowy, GM persona",
  "type": "object",
  "required": ["player_id", "player_name", "scores"],
  "properties": {
    "player_id": {
      "type": "string",
      "description": "Unikalny identyfikator gracza"
    },
    "player_name": {
      "type": "string",
      "description": "Imię gracza"
    },
    "archetype": {
      "type": ["string", "null"],
      "description": "Archetyp przypisany po quizie wstępnym",
      "enum": [null, "tropiciel_tajemnic", "zaklinacz_uczuc", "mistrz_map", "tkacz_snow", "gwardzista_odwagi", "straznik_mostu"]
    },
    "archetype_assigned_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Kiedy archetyp został przypisany (po quizie)"
    },
    "onboarding_answers": {
      "type": "array",
      "description": "Odpowiedzi z quizu wstępnego",
      "items": {
        "type": "object",
        "properties": {
          "question_id": { "type": "string" },
          "answer_id": { "type": "string" },
          "points_awarded": {
            "type": "object",
            "additionalProperties": { "type": "integer" }
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "description": "Punkty w 6 profilach kompetencyjnych w aktualnym cyklu (maks. 10 każdy)",
      "properties": {
        "EM": { "type": "integer", "minimum": 0, "maximum": 10 },
        "ST": { "type": "integer", "minimum": 0, "maximum": 10 },
        "KR": { "type": "integer", "minimum": 0, "maximum": 10 },
        "LD": { "type": "integer", "minimum": 0, "maximum": 10 },
        "DT": { "type": "integer", "minimum": 0, "maximum": 10 },
        "MD": { "type": "integer", "minimum": 0, "maximum": 10 }
      },
      "required": ["EM", "ST", "KR", "LD", "DT", "MD"]
    },
    "lifetime_scores": {
      "type": "object",
      "description": "Suma punktów ze wszystkich cykli (do długoterminowej analizy)",
      "properties": {
        "EM": { "type": "integer", "minimum": 0 },
        "ST": { "type": "integer", "minimum": 0 },
        "KR": { "type": "integer", "minimum": 0 },
        "LD": { "type": "integer", "minimum": 0 },
        "DT": { "type": "integer", "minimum": 0 },
        "MD": { "type": "integer", "minimum": 0 }
      }
    },
    "current_cycle_id": {
      "type": ["string", "null"],
      "description": "ID aktualnego cyklu tygodniowego gracza"
    },
    "current_chapter": {
      "type": ["string", "null"],
      "description": "Aktualny rozdział narracyjny w spójnym świecie",
      "examples": ["wezwanie_kroniki", "podrozprzez_szept_lasu", "sciezka_dwoch_glosow"]
    },
    "avatar": {
      "type": "object",
      "description": "Awatar oparty na stałym archetypie + odblokowane assety",
      "properties": {
        "base_image": { "type": "string" },
        "aura_color": { "type": "string" },
        "starter_item": { "type": "string" },
        "unlocked_assets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "backpack": {
      "type": "array",
      "description": "Plecak z artefaktami zdobytymi w trakcie cykli",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": { "type": "string" },
          "artifact_name": { "type": "string" },
          "awarded_at": { "type": "string", "format": "date-time" },
          "cycle_id": { "type": "string" }
        }
      }
    },
    "choices_log": {
      "type": "array",
      "description": "Log wszystkich wyborów gracza w cyklach",
      "items": {
        "type": "object",
        "properties": {
          "cycle_id": { "type": "string" },
          "chapter": { "type": "string" },
          "task_id": { "type": ["integer", "string"] },
          "choice_id": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "points_awarded": {
            "type": "object",
            "additionalProperties": { "type": "integer" }
          },
          "behavioral_data": {
            "type": "object",
            "properties": {
              "reaction_time_ms": { "type": "integer" },
              "free_text_input": { "type": "string" }
            }
          }
        }
      }
    },
    "gm_persona_id": {
      "type": ["string", "null"],
      "description": "ID persony Game Mastera widzianej przez dziecko (jednej, nawet gdy na zapleczu działa wielu dorosłych)"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
