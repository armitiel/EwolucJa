{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WeeklyMission",
  "description": "Misja w realu wygenerowana przez GAMA-1 dla gracza w danym cyklu",
  "type": "object",
  "required": ["mission_id", "cycle_id", "player_id", "title", "body", "proof_type", "status"],
  "properties": {
    "mission_id": { "type": "string" },
    "cycle_id": { "type": "string" },
    "player_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "title": {
      "type": "string",
      "description": "Krótki tytuł misji, np. 'Tropienie Trzech Sekretów'"
    },
    "body": {
      "type": "string",
      "description": "Treść misji prostym językiem (1–2 zdania)"
    },
    "narrative_intro": {
      "type": "string",
      "description": "Wstęp narracyjny od GAMA-1, claymorphism + bohaterski ton"
    },
    "competency_focus": {
      "type": "array",
      "description": "Kompetencje rozwijane przez misję",
      "items": {
        "type": "string",
        "enum": ["EM", "ST", "KR", "LD", "DT", "MD"]
      }
    },
    "proof_type": {
      "type": "string",
      "enum": ["conversation", "photo", "voice_note", "drawing", "physical_object", "gm_button"],
      "description": "Forma dowodu wykonania misji"
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 60
    },
    "safety_notes": {
      "type": "string",
      "description": "Notatki bezpieczeństwa (np. 'wymaga obecności dorosłego')"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "submitted", "verified", "highlighted", "needs_followup", "skipped"]
    },
    "submitted_proof": {
      "type": ["object", "null"],
      "properties": {
        "submitted_at": { "type": "string", "format": "date-time" },
        "proof_text": { "type": "string" },
        "proof_media_url": { "type": "string" }
      }
    },
    "gm_verification": {
      "type": ["object", "null"],
      "properties": {
        "verified_by_account_id": { "type": "string" },
        "verified_at": { "type": "string", "format": "date-time" },
        "verdict": {
          "type": "string",
          "enum": ["approved", "highlighted", "needs_followup"]
        },
        "comment_text": { "type": "string" },
        "comment_voice_url": { "type": "string" }
      }
    },
    "artifact_reward": {
      "type": ["object", "null"],
      "properties": {
        "artifact_id": { "type": "string" },
        "artifact_name": { "type": "string" }
      }
    }
  }
}
