<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Edytor mapy — EwolucJA</title>
<!--
  Edytor mapy świata 3D.

  Czym jest: rzut z góry na `mapa.json` — plik, z którego scena bierze całą
  geometrię (ścieżkę, rzekę, most, bramę, drzewa, głazy, budynki i znaki minigier).
  Bundle sceny jest zminifikowany i nie ma źródeł, więc `scripts/mapa-hook.py`
  otworzył w nim te literały na odczyt z `globalThis.__SCENA3D_MAPA`. Tu tę mapę
  rysujemy i zapisujemy z powrotem.

  Dlaczego plan 2D, a nie klikanie w 3D: świat jest płaski (teren ma stałą
  wysokość 0, wystaje tylko most), więc pozycja to para liczb X/Z. Rzut z góry
  daje precyzję co do dziesiątej części metra i nie wymaga wciągania three.js
  do narzędzia. Podgląd 3D siedzi obok w iframe i czyta wersję roboczą
  z localStorage — dlatego zmiany widać bez zapisywania pliku.

  Plik leży w `public/`, więc NIE wchodzi do builda aplikacji dziecka.
  Adres: /scena-3d/edytor.html
-->
<style>
  :root{
    --papier:#FBF1D6; --atrament:#4e4d76; --atrament2:#5A4F77;
    --magia:#7A4DC2; --magia2:#B886E8; --czerwien:#C4553F;
    --panel:#fffdf6; --kant:rgba(78,77,118,.16);
  }
  *{box-sizing:border-box}
  body{
    margin:0; height:100vh; display:grid; grid-template-rows:auto 1fr;
    font:14px/1.4 'Nunito',system-ui,sans-serif; color:var(--atrament);
    background:linear-gradient(180deg,#FDF7E7,#F1E4C4); overflow:hidden;
  }
  header{
    display:flex; align-items:center; gap:8px; padding:8px 14px;
    background:var(--panel); border-bottom:1px solid var(--kant); flex-wrap:wrap;
  }
  header h1{font-size:16px; margin:0 12px 0 0; font-weight:900}
  header .info{margin-left:auto; font-size:12px; color:var(--atrament2)}
  button, select, input{font:inherit; color:var(--atrament)}
  button{border:1px solid var(--kant); background:#fff; border-radius:9px;
         padding:6px 11px; cursor:pointer; font-weight:700}
  button:hover{background:#F7F0DC}
  button.glowny{background:linear-gradient(180deg,#C8A0F0,#7A4DC2); color:#fff; border-color:#5b3795}
  button.wybrany{background:linear-gradient(180deg,#FFD269,#E89A3D); border-color:#b47322; color:#4A2A0E}
  button.groza{color:var(--czerwien); margin-top:8px}
  main{display:grid; grid-template-columns:246px 1fr 310px; min-height:0; height:100%}
  /* min-height:0 na kolumnie jest konieczne: bez niego element siatki rozpycha
     wiersz do wysokosci tresci i pasek przewijania nigdy sie nie pojawia. */
  aside{background:var(--panel); overflow-y:auto; overflow-x:hidden; min-height:0; height:100%; padding:12px}
  aside.lewy{border-right:1px solid var(--kant)}
  aside.prawy{border-left:1px solid var(--kant)}
  h2{font-size:11px; text-transform:uppercase; letter-spacing:.8px; color:var(--atrament2); margin:14px 0 6px}
  h2:first-child{margin-top:0}
  .narzedzia{display:grid; grid-template-columns:1fr 1fr; gap:6px}
  .narzedzia button{padding:8px 6px; font-size:12.5px}
  #plansza{position:relative; min-width:0; display:flex}
  svg{width:100%; height:100%; touch-action:none; cursor:crosshair; user-select:none; -webkit-user-select:none;
      background:radial-gradient(circle at 50% 45%, #F7EFD8 0%, #EADFBC 70%, #E0D3AC 100%)}
  .lista{display:flex; flex-direction:column; gap:3px}
  .lista button{text-align:left; font-weight:600; font-size:12.5px; padding:5px 8px; display:flex; gap:6px}
  .lista button.akt{background:#EFE3FA; border-color:var(--magia2)}
  .lista .znacznik{width:9px; height:9px; border-radius:50%; align-self:center; flex:none}
  .pole{display:grid; grid-template-columns:80px 1fr; gap:6px; align-items:center; margin-bottom:6px}
  .pole label{font-size:11.5px; color:var(--atrament2); font-weight:700}
  .pole input, .pole select{width:100%; padding:4px 6px; border:1px solid var(--kant); border-radius:7px; background:#fff}
  .para2{display:grid; grid-template-columns:1fr 1fr; gap:4px}
  .podpowiedz{font-size:11.5px; color:var(--atrament2); background:#F6EFDA; border-radius:8px; padding:7px 9px; margin-top:8px}
  #podglad{border-radius:12px; overflow:hidden; background:#1B1338; border:1px solid var(--kant)}
  #podglad iframe{display:block; width:100%; height:360px; border:0; background:#1B1338}
  #podglad .pasek{display:flex; gap:8px; align-items:center; padding:6px 8px; background:#fff}
  #podglad .pasek a{font-size:12px; font-weight:800; color:var(--magia); text-decoration:none}
  #podglad .pasek a:hover{text-decoration:underline}
  #stan-podgladu{padding:5px 8px; font-size:11.5px; font-weight:700; color:#fff; background:#2b2350}
  #stan-podgladu.ok{background:#2F5841}
  #stan-podgladu.zle{background:#7d2f2f}
  .pusty{color:var(--atrament2); font-size:12.5px}
  .suwak{display:grid; grid-template-columns:1fr 58px; gap:6px; align-items:center}
  .suwak input[type=range]{width:100%; accent-color:var(--magia)}
  .przyciski-rzad{display:flex; gap:6px; flex-wrap:wrap; margin:6px 0}
  .przyciski-rzad button{flex:1; font-size:12px; padding:5px 6px}
  .auto{display:flex; align-items:center; gap:6px; font-size:12px; font-weight:700; color:var(--atrament2)}
  svg.lapa{cursor:grab}
  svg.lapa-trzyma{cursor:grabbing}
</style>
</head>
<body>

<header>
  <h1>Edytor mapy</h1>
  <button id="btn-cofnij" title="Ctrl+Z">Cofnij</button>
  <button id="btn-widok" title="Wróć do widoku całej mapy">Dopasuj widok</button>
  <button id="btn-plik">Wczytaj plik…</button>
  <button id="btn-oryginal">Wczytaj z serwera</button>
  <button id="btn-zapisz" class="glowny">Zapisz w projekcie</button>
  <label class="auto"><input type="checkbox" id="auto"> auto</label>
  <button id="btn-pobierz">Pobierz plik</button>
  <input type="file" id="plik" accept="application/json" hidden>
  <span class="info" id="info">—</span>
</header>

<main>
  <aside class="lewy">
    <h2>Narzędzie</h2>
    <div class="narzedzia" id="narzedzia"></div>
    <h2>Model do postawienia</h2>
    <select id="model"></select>
    <div class="podpowiedz" id="podpowiedz-narzedzia"></div>
    <div class="podpowiedz">Widok: kółko myszy przybliża, <b>prawy przycisk</b> (albo spacja) przesuwa mapę, „Dopasuj widok” wraca do całości.</div>

    <h2>Na mapie</h2>
    <div class="lista" id="lista"></div>
  </aside>

  <section id="plansza">
    <svg id="plan" viewBox="-19 -19 38 38" preserveAspectRatio="xMidYMid meet"></svg>
  </section>

  <aside class="prawy">
    <h2>Podgląd 3D</h2>
    <div id="podglad">
      <iframe id="ramka" src="about:blank" title="Podgląd sceny"></iframe>
      <div id="stan-podgladu">czekam na scenę…</div>
      <div class="pasek">
        <button id="btn-odswiez">Odśwież</button>
        <a id="link-podglad" href="index.html?panel=0&amp;mapa=podglad" target="_blank" rel="noopener">Otwórz w karcie</a>
      </div>
    </div>

    <h2>Właściwości</h2>
    <div id="wlasciwosci"><p class="pusty">Kliknij coś na mapie.</p></div>
  </aside>
</main>

<script>
/* ── Model danych ─────────────────────────────────────────────────────────
   `mapa` ma dokładnie kształt pliku `mapa.json`, który czyta scena. Edytor nie
   trzyma własnej reprezentacji — dzięki temu „co widzisz, to zapiszesz”, a pola,
   których edytor nie zna, przechodzą przez niego nietknięte.                  */

const KLUCZ = 'scena3d.mapa';
const MODELE = ['karta','gwiazda','medal','lisc','wizard','hut2','hut','postac'];

let mapa = null;
let wybor = null;            // { typ, idx }
let tryb = 'wybor';
const historia = [];

const $ = (s) => document.querySelector(s);
const plan = $('#plan');
const zaokr = (v) => Math.round(v * 100) / 100;

const TRYBY = [
  { id:'wybor',   nazwa:'Wybierz',   opis:'Klikasz obiekt i przeciągasz po mapie. Delete kasuje, Q/E obracają, [ oraz ] zmieniają skalę, strzałki przesuwają co 10 cm.' },
  { id:'znak',    nazwa:'+ Znak',    opis:'Znak minigry: świeci, dziecko go dotyka, do aplikacji leci zdarzenie. Po postawieniu ustaw etykietę i toast po prawej.' },
  { id:'budynek', nazwa:'+ Budynek', opis:'Model GLB stojący na ziemi. „Kolizja r” to kółko, którego dziecko nie przejdzie — ustaw je mniej więcej na obrys bryły.' },
  { id:'drzewo',  nazwa:'+ Drzewo',  opis:'Drzewo z generatora sceny: sosna albo liściaste. Kolizja stała 0,75.' },
  { id:'glaz',    nazwa:'+ Głaz',    opis:'Głaz z generatora sceny. Kolizja rośnie ze skalą.' },
  { id:'sciezka', nazwa:'Ścieżka',   opis:'Klik dokłada punkt na końcu ścieżki, klik w punkt zaznacza go, przeciąganie przesuwa. Ścieżka to trasa spaceru i rysunek na trawie — nie blokuje chodzenia.' },
];

function rysujNarzedzia() {
  $('#narzedzia').innerHTML = '';
  for (const t of TRYBY) {
    const b = document.createElement('button');
    b.textContent = t.nazwa;
    b.className = t.id === tryb ? 'wybrany' : '';
    b.onclick = () => { tryb = t.id; rysujNarzedzia(); };
    $('#narzedzia').appendChild(b);
  }
  $('#podpowiedz-narzedzia').textContent = TRYBY.find((t) => t.id === tryb).opis;
}

/* ── Wczytanie i zapis ───────────────────────────────────────────────────── */
async function wczytaj({ zSerwera = false } = {}) {
  if (!zSerwera) {
    try {
      const robocza = localStorage.getItem(KLUCZ);
      if (robocza) { ustaw(JSON.parse(robocza), 'wersja robocza z tej przeglądarki'); return; }
    } catch (e) { console.warn(e); }
  }
  const odp = await fetch('mapa.json', { cache: 'no-cache' });
  ustaw(await odp.json(), 'mapa.json z serwera');
}

function ustaw(m, skad) {
  mapa = m;
  zapewnijWezly();
  przeliczSciezke();
  wybor = null;
  historia.length = 0;
  $('#info').textContent = skad;
  zapisz({ bezHistorii: true });
  rysuj();
  odswiezPodglad();
}

function zapisz({ bezHistorii = false } = {}) {
  if (!bezHistorii) {
    historia.push(JSON.stringify(mapa));
    if (historia.length > 60) historia.shift();
  }
  try { localStorage.setItem(KLUCZ, JSON.stringify(mapa)); } catch (e) { console.warn(e); }
  autozapis();
}

function cofnij() {
  if (historia.length < 2) return;
  historia.pop();
  mapa = JSON.parse(historia[historia.length - 1]);
  wybor = null;
  zapisz({ bezHistorii: true });
  rysuj();
}

function pobierz() {
  const blob = new Blob([JSON.stringify(mapa, null, 2)], { type:'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'mapa.json';
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 4000);
}

/**
 * Zapis do projektu. Strona w `public/` nie ma dostepu do dysku, wiec plik
 * zapisuje serwer deweloperski: koncowka `POST /__mapa` z `vite.config.js`.
 * Poza `npm run dev` to nie zadziala — i dobrze, bo na produkcji nikt nie ma
 * prawa przestawiac mapy przez HTTP. Wtedy zostaje „Pobierz plik".
 */
async function zapiszWProjekcie({ cicho = false } = {}) {
  try {
    const odp = await fetch('/__mapa', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(mapa),
    });
    const dane = await odp.json();
    $('#info').textContent = dane.ok
      ? 'zapisane → public/scena-3d/mapa.json  (' + new Date().toLocaleTimeString('pl') + ')'
      : 'błąd zapisu: ' + dane.blad;
    return dane.ok;
  } catch (e) {
    $('#info').textContent = cicho ? 'autozapis nieczynny (uruchom npm run dev)'
                                   : 'zapis działa tylko przy npm run dev — użyj „Pobierz plik"';
    return false;
  }
}

let autozapisCzeka = null;
function autozapis() {
  if (!$('#auto').checked) return;
  clearTimeout(autozapisCzeka);
  autozapisCzeka = setTimeout(() => zapiszWProjekcie({ cicho: true }), 1200);
}

function odswiezPodglad() {
  // iframe czyta wersję roboczą z localStorage — patrz index.html, gałąź ?mapa=podglad
  stanPodgladu('wczytuję scenę…', '');
  $('#ramka').src = 'index.html?panel=0&mapa=podglad&t=' + Date.now();
}

function stanPodgladu(tekst, klasa) {
  const e = $('#stan-podgladu');
  e.textContent = tekst;
  e.className = klasa;
}

/**
 * Moduł sceny, gdy siedzi w iframe, melduje o sobie przez `postMessage`
 * (`{ scena3d:'zdarzenie', nazwa:'gotowa' | 'blad' }`). Bez tego czarny
 * prostokąt w podglądzie znaczy jednocześnie „wczytuję", „nie mam WebGL"
 * i „wywaliłem się" — a to trzy różne rzeczy do zrobienia.
 */
window.addEventListener('message', (ev) => {
  const d = ev.data;
  if (!d || d.scena3d !== 'zdarzenie') return;
  if (d.nazwa === 'gotowa') stanPodgladu('scena wczytana', 'ok');
  else if (d.nazwa === 'blad') stanPodgladu('błąd sceny: ' + (d.dane?.komunikat || 'sprawdź konsolę'), 'zle');
});

/* ── Ścieżka: węzły, łuki, próbkowanie ────────────────────────────────────
   Scena czyta ze `sciezka` zwykłą ŁAMANĄ — nie zna splajnów i nie da się jej
   tego nauczyć bez źródeł modułu. Łuki robimy więc po naszej stronie: edytor
   trzyma garść WĘZŁÓW (`sciezkaWezly`), a przy każdej zmianie wypala z nich
   gęstą łamaną do `sciezka`. Scena dostaje to, co rozumie, a Ty ciągniesz kilka
   punktów zamiast trzydziestu.

   `gladkosc` miesza między odcinkiem prostym (0) a splajnem Catmulla-Roma (1),
   więc suwak przechodzi płynnie od ostrych kantów do zaokrąglonych łuków.
   `probki` mówi, na ile kawałków ciąć każdy odcinek — im więcej, tym gładszy
   łuk i tym dłuższa tablica w pliku.                                         */

function zapewnijWezly() {
  if (!mapa.sciezkaWezly) {
    mapa.sciezkaWezly = {
      punkty: (mapa.sciezka || []).map((p) => [...p]),
      gladkosc: 0,      // 0 = dokładnie to, co dziś w grze — nic się nie zmienia
      probki: 1,
      wezelLatarni: mapa.latarnia?.punktSciezki ?? 0,
    };
  }
}
const wezly = () => mapa.sciezkaWezly.punkty;

function catmull(p0, p1, p2, p3, u, t) {
  const prosto = [p1[0] + (p2[0] - p1[0]) * u, p1[1] + (p2[1] - p1[1]) * u];
  if (!t) return prosto;
  const u2 = u * u, u3 = u2 * u;
  const cr = (a, b, c, d) => .5 * (2 * b + (-a + c) * u + (2 * a - 5 * b + 4 * c - d) * u2 + (-a + 3 * b - 3 * c + d) * u3);
  const splajn = [cr(p0[0], p1[0], p2[0], p3[0]), cr(p0[1], p1[1], p2[1], p3[1])];
  return [prosto[0] + (splajn[0] - prosto[0]) * t, prosto[1] + (splajn[1] - prosto[1]) * t];
}

function przeliczSciezke() {
  zapewnijWezly();
  const w = mapa.sciezkaWezly;
  const P = w.punkty;
  const probki = Math.max(1, Math.round(w.probki || 1));
  if (P.length < 2) { mapa.sciezka = P.map((p) => [...p]); return; }
  const wez = (i) => P[Math.max(0, Math.min(P.length - 1, i))];
  const out = [];
  for (let i = 0; i < P.length - 1; i++)
    for (let s = 0; s < probki; s++)
      out.push(catmull(wez(i - 1), wez(i), wez(i + 1), wez(i + 2), s / probki, w.gladkosc || 0));
  out.push([...P[P.length - 1]]);
  mapa.sciezka = out.map((p) => [zaokr(p[0]), zaokr(p[1])]);

  // Latarnia wskazuje INDEKS w wypalonej łamanej, więc po każdym przeliczeniu
  // trzeba go przeliczyć z numeru węzła — inaczej bohater szedłby w inne miejsce.
  if (mapa.latarnia)
    mapa.latarnia.punktSciezki = Math.min(mapa.sciezka.length - 1,
      Math.max(0, Math.round((w.wezelLatarni ?? 0) * probki)));
}

/* ── Geometria ───────────────────────────────────────────────────────────── */
function bezier(a, b, c, t) {
  const u = 1 - t;
  return [u*u*a[0] + 2*u*t*b[0] + t*t*c[0], u*u*a[1] + 2*u*t*b[1] + t*t*c[1]];
}
function punktyRzeki() {
  const out = [];
  (mapa.rzeka?.krzywe || []).forEach((k, ki) => {
    const n = k.kroki || 12;
    for (let i = (ki ? 1 : 0); i <= n; i++) out.push(bezier(k.od, k.kontrola, k.do, i / n));
  });
  return out;
}

/* ── Rysowanie planu ─────────────────────────────────────────────────────── */
const NS = 'http://www.w3.org/2000/svg';
function el(nazwa, atrybuty) {
  const e = document.createElementNS(NS, nazwa);
  for (const [k, v] of Object.entries(atrybuty || {})) e.setAttribute(k, v);
  plan.appendChild(e);
  return e;
}

function uchwyt(typ, idx, e) {
  e.dataset.typ = typ;
  e.dataset.idx = idx;
  e.style.cursor = 'grab';
  if (wybor && wybor.typ === typ && String(wybor.idx) === String(idx)) {
    e.setAttribute('stroke', '#7A4DC2');
    e.setAttribute('stroke-width', '.16');
  }
  return e;
}

function rysuj() {
  plan.innerHTML = '';
  if (!mapa) return;
  const teren = mapa.swiat?.teren ?? 36;
  const promien = mapa.swiat?.promien ?? 12.5;

  el('rect', { x:-teren/2, y:-teren/2, width:teren, height:teren, fill:'#DCEBC0', stroke:'#C3D5A2', 'stroke-width':.06 });
  el('circle', { cx:0, cy:0, r:promien, fill:'none', stroke:'#B7C79A', 'stroke-width':.09, 'stroke-dasharray':'.5 .35' });
  for (let i = -18; i <= 18; i++) {
    const g = i % 5 === 0 ? .09 : .04;
    el('line', { x1:i, y1:-18, x2:i, y2:18, stroke:'#000', 'stroke-opacity':g, 'stroke-width':.02 });
    el('line', { x1:-18, y1:i, x2:18, y2:i, stroke:'#000', 'stroke-opacity':g, 'stroke-width':.02 });
  }
  el('text', { x:.15, y:-.15, 'font-size':.5, fill:'#4e4d76', 'fill-opacity':.5 }).textContent = '0,0';

  const rz = punktyRzeki();
  if (rz.length > 1) el('polyline', {
    points: rz.map((p) => p.join(',')).join(' '), fill:'none', stroke:'#8FCBE8',
    'stroke-width': (mapa.rzeka?.szerokosc ?? 1.5) * 2, 'stroke-linecap':'round',
    'stroke-linejoin':'round', 'stroke-opacity':.85 });

  (mapa.rzeka?.krzywe || []).forEach((k, i) => {
    el('polyline', { points: `${k.od.join(',')} ${k.kontrola.join(',')} ${k.do.join(',')}`,
      fill:'none', stroke:'#2E7AB8', 'stroke-opacity':.4, 'stroke-width':.05, 'stroke-dasharray':'.25 .2' });
    ['od','kontrola','do'].forEach((rola) => {
      const p = k[rola];
      uchwyt('rzeka', i + ':' + rola, el('circle', {
        cx:p[0], cy:p[1], r: rola === 'kontrola' ? .2 : .26,
        fill: rola === 'kontrola' ? '#fff' : '#2E7AB8', stroke:'#2E7AB8', 'stroke-width':.07 }));
    });
  });

  const sc = mapa.sciezka || [];
  if (sc.length > 1) el('polyline', { points: sc.map((p) => p.join(',')).join(' '), fill:'none',
    stroke:'#D9BE86', 'stroke-width':.75, 'stroke-linecap':'round', 'stroke-linejoin':'round' });

  // Cienka linia łącząca węzły pokazuje, co właściwie ciągniesz — przy dużej
  // gładkości wstęga potrafi odejść od węzłów o pół metra.
  const W = wezly();
  if (W.length > 1 && (mapa.sciezkaWezly.gladkosc || 0) > 0)
    el('polyline', { points: W.map((p) => p.join(',')).join(' '), fill:'none',
      stroke:'#7A4DC2', 'stroke-opacity':.35, 'stroke-width':.05, 'stroke-dasharray':'.25 .2' });
  W.forEach((p, i) => uchwyt('sciezka', i, el('circle', {
    cx:p[0], cy:p[1], r:.24, fill:'#B98F4A', stroke:'#fff', 'stroke-width':.07 })));

  if (tryb === 'sciezka') {
    // plusik na środku każdego odcinka = wstaw wierzchołek, plusik za końcami = przedłuż
    const plus = (x, z, gdzie) => {
      const g = el('g', {});
      const k = document.createElementNS(NS, 'circle');
      k.setAttribute('cx', x); k.setAttribute('cy', z); k.setAttribute('r', .28);
      k.setAttribute('fill', '#fff'); k.setAttribute('stroke', '#7A4DC2'); k.setAttribute('stroke-width', .07);
      const l1 = document.createElementNS(NS, 'path');
      l1.setAttribute('d', `M${x - .14},${z} H${x + .14} M${x},${z - .14} V${z + .14}`);
      l1.setAttribute('stroke', '#7A4DC2'); l1.setAttribute('stroke-width', .09);
      // Klik trafia w KÓŁKO, nie w grupę — grupa sama z siebie nie ma pola
      // trafienia, a krzyżyk musi być przezroczysty dla myszy, żeby dziura
      // w środku plusika nie przepuszczała kliknięcia na tło.
      k.dataset.typ = 'wstaw-sciezke';
      k.dataset.idx = gdzie;
      k.style.cursor = 'copy';
      l1.style.pointerEvents = 'none';
      g.append(k, l1);
    };
    for (let i = 0; i < W.length - 1; i++)
      plus((W[i][0] + W[i + 1][0]) / 2, (W[i][1] + W[i + 1][1]) / 2, i + 1);
    if (W.length > 1) {
      const a = W[0], b = W[1], c = W[W.length - 2], d = W[W.length - 1];
      plus(a[0] + (a[0] - b[0]), a[1] + (a[1] - b[1]), 0);
      plus(d[0] + (d[0] - c[0]), d[1] + (d[1] - c[1]), W.length);
    }
  }

  if (mapa.most) {
    const p = mapa.most.pos, a = sc[1], b = sc[2];
    const kat = a && b ? Math.atan2(b[0]-a[0], b[1]-a[1]) * 180 / Math.PI : 0;
    uchwyt('most', 0, el('rect', { x:p[0]-1, y:p[1]-2.1, width:2, height:4.2, rx:.2,
      fill:'#C9A06A', stroke:'#8a6636', 'stroke-width':.06,
      transform:`rotate(${-kat} ${p[0]} ${p[1]})` }));
  }
  if (mapa.brama) {
    const p = mapa.brama.pos;
    uchwyt('brama', 0, el('rect', { x:p[0]-1.6, y:p[1]-.35, width:3.2, height:.7, rx:.25,
      fill:'#B58A5B', stroke:'#7a5734', 'stroke-width':.06 }));
  }
  if (mapa.latarnia) {
    const p = mapa.latarnia.pos;
    uchwyt('latarnia', 0, el('circle', { cx:p[0], cy:p[1], r:.42, fill:'#FFE08A', stroke:'#C9922E', 'stroke-width':.09 }));
  }

  const kreskaObrotu = (o, r, kolor) => {
    const k = o.obrot;
    if (k == null) return;
    el('line', { x1:o.pos[0], y1:o.pos[1], x2:o.pos[0] + Math.sin(k) * r, y2:o.pos[1] + Math.cos(k) * r,
      stroke:kolor, 'stroke-width':.09, 'stroke-linecap':'round' });
  };
  (mapa.drzewa || []).forEach((d, i) => {
    uchwyt('drzewo', i, el('circle', {
      cx:d.pos[0], cy:d.pos[1], r:.75 * (d.skala ?? 1),
      fill: d.typ === 'lisciaste' ? '#7CC079' : '#4E8F5E', 'fill-opacity':.9,
      stroke:'#33613f', 'stroke-width':.06 }));
    kreskaObrotu(d, .75 * (d.skala ?? 1), '#33613f');
  });
  (mapa.glazy || []).forEach((g, i) => {
    uchwyt('glaz', i, el('circle', {
      cx:g.pos[0], cy:g.pos[1], r:.55 * (g.skala ?? 1), fill:'#B9B3A6', stroke:'#7d786d', 'stroke-width':.06 }));
    kreskaObrotu(g, .55 * (g.skala ?? 1), '#5f5b53');
  });

  (mapa.budynki || []).forEach((b, i) => {
    const r = b.promien ?? 1.4, p = b.pos, kat = b.obrot ?? 0;
    uchwyt('budynek', i, el('rect', { x:p[0]-r, y:p[1]-r, width:r*2, height:r*2, rx:.25,
      fill:'#E2B98C', stroke:'#9a6b3c', 'stroke-width':.08,
      transform:`rotate(${-kat * 180 / Math.PI} ${p[0]} ${p[1]})` }));
    el('line', { x1:p[0], y1:p[1], x2:p[0] + Math.sin(kat) * r, y2:p[1] + Math.cos(kat) * r,
      stroke:'#8a5a2b', 'stroke-width':.09 });
    el('text', { x:p[0], y:p[1] - r - .25, 'font-size':.45, 'text-anchor':'middle', fill:'#6b4b2a' }).textContent = b.file;
  });

  (mapa.znaki || []).forEach((z, i) => {
    const p = z.pos || [0,0], r = .45 * (z.scale ?? 1), kat = z.obrotY ?? 0;
    uchwyt('znak', i, el('polygon', {
      points:`${p[0]},${p[1]-r} ${p[0]+r},${p[1]} ${p[0]},${p[1]+r} ${p[0]-r},${p[1]}`,
      fill:'#FFD269', stroke:'#B47322', 'stroke-width':.07,
      transform:`rotate(${-kat * 180 / Math.PI} ${p[0]} ${p[1]})` }));
    // Wskaźnik kierunku — bez niego romb wygląda tak samo pod każdym kątem
    // i obracanie sprawia wrażenie, że nic się nie dzieje.
    if (obrotDziala(z))
      el('line', { x1:p[0], y1:p[1], x2:p[0] + Math.sin(kat) * (r + .35), y2:p[1] + Math.cos(kat) * (r + .35),
        stroke:'#B47322', 'stroke-width':.1, 'stroke-linecap':'round' });
    el('text', { x:p[0], y:p[1] + r + .55, 'font-size':.42, 'text-anchor':'middle', fill:'#6b4b2a' }).textContent = z.id;
  });

  rysujUchwyty();
  rysujListe();
  rysujWlasciwosci();
}

/** Pola, po ktorych „skaluje sie" dany typ — kazdy ma inna jednostke. */
const POLE_SKALI = { znak:'scale', drzewo:'skala', glaz:'skala', budynek:'wysokosc' };
const POLE_OBROTU = { znak:'obrotY', budynek:'obrot', drzewo:'obrot', glaz:'obrot' };

/**
 * Czy silnik w ogóle POSŁUCHA zadanego kąta znaku.
 *
 * Scena traktuje znaki trojako: `faceCamera` obraca je za kamerą, brak obu flag
 * znaczy „kręć się w kółko", i dopiero `bezObrotu` przykręca model do kąta
 * z danych. Czarodziej ma `bezObrotu`, więc daje się ustawić — gwiazdki i medal
 * nie, i dlatego kręcenie nimi w edytorze wyglądało na zepsute. Zamiast to
 * ukrywać, pokazujemy stan wprost i pozwalamy przełączyć zachowanie.
 */
function obrotDziala(z) {
  return !!z.bezObrotu && !z.faceCamera;
}

/**
 * Dwa uchwyty przy zaznaczonym obiekcie: kolko NAD nim obraca, kwadrat OBOK
 * skaluje. To ta sama robota co suwaki po prawej, tylko pod ręką — przy
 * ustawianiu chaty względem ścieżki wygodniej ciągnąć niż celować w liczbę.
 */
function rysujUchwyty() {
  if (!wybor) return;
  const o = obiektWyboru();
  if (!o || !o.pos || (!POLE_SKALI[wybor.typ] && !POLE_OBROTU[wybor.typ])) return;
  const [x, z] = o.pos;
  const r = promienRysunku(wybor.typ, o) + .7;

  el('line', { x1:x, y1:z, x2:x, y2:z - r, stroke:'#7A4DC2', 'stroke-width':.05, 'stroke-dasharray':'.2 .2' });
  const obrot = el('circle', { cx:x, cy:z - r, r:.26, fill:'#EFE3FA', stroke:'#7A4DC2', 'stroke-width':.08 });
  obrot.dataset.typ = 'uchwyt-obrot';
  obrot.dataset.idx = '0';
  obrot.style.cursor = 'alias';

  const skala = el('rect', { x:x + r - .24, y:z - .24, width:.48, height:.48, rx:.1,
                             fill:'#FFF3D3', stroke:'#B47322', 'stroke-width':.08 });
  skala.dataset.typ = 'uchwyt-skala';
  skala.dataset.idx = '0';
  skala.style.cursor = 'ew-resize';
}

function promienRysunku(typ, o) {
  if (typ === 'znak') return .45 * (o.scale ?? 1);
  if (typ === 'drzewo') return .75 * (o.skala ?? 1);
  if (typ === 'glaz') return .55 * (o.skala ?? 1);
  if (typ === 'budynek') return o.promien ?? 1.4;
  return .5;
}

/* ── Lista obiektów ──────────────────────────────────────────────────────── */
const KOLORY = { znak:'#FFD269', budynek:'#E2B98C', drzewo:'#4E8F5E', glaz:'#B9B3A6',
                 latarnia:'#FFE08A', brama:'#B58A5B', most:'#C9A06A' };

function rysujListe() {
  const lista = $('#lista');
  lista.innerHTML = '';
  const dodaj = (typ, idx, tekst) => {
    const b = document.createElement('button');
    const kropka = document.createElement('span');
    kropka.className = 'znacznik';
    kropka.style.background = KOLORY[typ] || '#ccc';
    b.append(kropka, document.createTextNode(tekst));
    if (wybor && wybor.typ === typ && String(wybor.idx) === String(idx)) b.className = 'akt';
    b.onclick = () => { wybor = { typ, idx }; rysuj(); };
    lista.appendChild(b);
  };
  (mapa.znaki || []).forEach((z, i) => dodaj('znak', i, z.id + ' · ' + z.file));
  (mapa.budynki || []).forEach((b, i) => dodaj('budynek', i, b.file));
  (mapa.drzewa || []).forEach((d, i) => dodaj('drzewo', i, 'drzewo ' + (i + 1) + ' · ' + d.typ));
  (mapa.glazy || []).forEach((g, i) => dodaj('glaz', i, 'głaz ' + (i + 1)));
  if (mapa.latarnia) dodaj('latarnia', 0, 'latarnia');
  if (mapa.brama) dodaj('brama', 0, 'brama');
  if (mapa.most) dodaj('most', 0, 'most');
}

/* ── Panel właściwości ───────────────────────────────────────────────────── */
function obiektWyboru() {
  if (!wybor) return null;
  const { typ, idx } = wybor;
  if (typ === 'znak') return mapa.znaki?.[idx];
  if (typ === 'budynek') return mapa.budynki?.[idx];
  if (typ === 'drzewo') return mapa.drzewa?.[idx];
  if (typ === 'glaz') return mapa.glazy?.[idx];
  if (typ === 'latarnia') return mapa.latarnia;
  if (typ === 'brama') return mapa.brama;
  if (typ === 'most') return mapa.most;
  if (typ === 'sciezka') return { pos: wezly()[idx] };
  if (typ === 'rzeka') { const [i, rola] = String(idx).split(':'); return { pos: mapa.rzeka.krzywe[i][rola] }; }
  return null;
}

function pole(rodzic, etykieta) {
  const w = document.createElement('div');
  w.className = 'pole';
  const l = document.createElement('label');
  l.textContent = etykieta;
  w.appendChild(l);
  rodzic.appendChild(w);
  return w;
}
function poleTekst(rodzic, etykieta, wartosc, przy, typ = 'text') {
  const w = pole(rodzic, etykieta);
  const i = document.createElement('input');
  i.type = typ;
  if (typ === 'number') i.step = '0.05';
  i.value = wartosc ?? '';
  i.oninput = () => przy(typ === 'number' ? Number(i.value) : i.value);
  w.appendChild(i);
}
function polePara(rodzic, etykieta, para) {
  const w = pole(rodzic, etykieta);
  const box = document.createElement('div');
  box.className = 'para2';
  [0, 1].forEach((k) => {
    const i = document.createElement('input');
    i.type = 'number'; i.step = '0.1'; i.value = para[k];
    i.oninput = () => { para[k] = Number(i.value); zapisz(); rysuj(); };
    box.appendChild(i);
  });
  w.appendChild(box);
}
/** Suwak + pole liczbowe na jednej linii — do skali, obrotu i wysokosci.
 *  Suwak jest do „pokreccenia na oko", pole obok do wpisania konkretu.        */
function poleSuwak(rodzic, etykieta, wartosc, { min, max, krok = .05 }, przy) {
  const w = pole(rodzic, etykieta);
  const box = document.createElement('div');
  box.className = 'suwak';
  const s = document.createElement('input');
  const n = document.createElement('input');
  s.type = 'range'; s.min = min; s.max = max; s.step = krok; s.value = wartosc ?? min;
  n.type = 'number'; n.step = krok; n.value = wartosc ?? min;
  s.oninput = () => { n.value = s.value; przy(Number(s.value)); };
  n.oninput = () => { s.value = n.value; przy(Number(n.value)); };
  box.append(s, n);
  w.appendChild(box);
}

function poleWybor(rodzic, etykieta, wartosc, opcje, przy) {
  const w = pole(rodzic, etykieta);
  const s = document.createElement('select');
  const lista = opcje.includes(wartosc) ? opcje : [wartosc, ...opcje];
  for (const o of lista) {
    const opt = document.createElement('option');
    opt.value = o; opt.textContent = o;
    if (o === wartosc) opt.selected = true;
    s.appendChild(opt);
  }
  s.onchange = () => przy(s.value);
  w.appendChild(s);
}
function poleKolor(rodzic, etykieta, liczba, przy) {
  const w = pole(rodzic, etykieta);
  const i = document.createElement('input');
  i.type = 'color';
  i.value = '#' + Number(liczba || 0).toString(16).padStart(6, '0');
  i.oninput = () => przy(parseInt(i.value.slice(1), 16));
  w.appendChild(i);
}
function poleTak(rodzic, etykieta, wartosc, przy) {
  const w = pole(rodzic, etykieta);
  const i = document.createElement('input');
  i.type = 'checkbox';
  i.checked = !!wartosc;
  i.onchange = () => przy(i.checked);
  w.appendChild(i);
}
function podpowiedz(rodzic, tekst) {
  const p = document.createElement('div');
  p.className = 'podpowiedz';
  p.textContent = tekst;
  rodzic.appendChild(p);
}

/** Suwaki łuku ścieżki — te same w panelu węzła i w panelu świata. */
function ustawieniaLuku(box) {
  zapewnijWezly();
  const w = mapa.sciezkaWezly;
  poleSuwak(box, 'łuk ścieżki', w.gladkosc ?? 0, { min:0, max:1, krok:.05 }, (v) => {
    w.gladkosc = v;
    if (v > 0 && (w.probki || 1) < 6) w.probki = 8;   // sam splajn bez próbek nic nie da
    przeliczSciezke(); zapisz(); rysuj();
  });
  poleSuwak(box, 'gęstość', w.probki ?? 1, { min:1, max:16, krok:1 }, (v) => {
    w.probki = Math.round(v);
    przeliczSciezke(); zapisz(); rysuj();
  });
}

function rysujWlasciwosci() {
  const box = $('#wlasciwosci');
  box.innerHTML = '';
  const o = obiektWyboru();
  const zmiana = () => { zapisz(); rysuj(); };

  if (!o) {
    box.innerHTML = '<p class="pusty">Nic nie zaznaczone — poniżej ustawienia całego świata.</p><h2>Świat</h2>';
    poleTekst(box, 'promień', mapa.swiat?.promien, (v) => { mapa.swiat.promien = v; zmiana(); }, 'number');
    poleTekst(box, 'teren', mapa.swiat?.teren, (v) => { mapa.swiat.teren = v; zmiana(); }, 'number');
    poleSuwak(box, 'szer. rzeki', mapa.rzeka?.szerokosc, { min:.4, max:4, krok:.1 }, (v) => { mapa.rzeka.szerokosc = v; zmiana(); });
    ustawieniaLuku(box);
    podpowiedz(box, 'Promień to granica chodzenia bohatera, teren to bok trawy pod sceną. Rzeka wyznacza, gdzie chodzić NIE można — z wyjątkiem mostu.');
    return;
  }

  const naglowek = document.createElement('h2');
  naglowek.textContent = wybor.typ;
  box.appendChild(naglowek);
  if (o.pos) polePara(box, 'pozycja X / Z', o.pos);

  if (wybor.typ === 'znak') {
    poleTekst(box, 'id', o.id, (v) => { o.id = v; zmiana(); });
    poleWybor(box, 'model', o.file, MODELE, (v) => { o.file = v; zmiana(); });
    poleTekst(box, 'etykieta', o.label, (v) => { o.label = v; zmiana(); });
    poleTekst(box, 'toast', o.toast, (v) => { o.toast = v; zmiana(); });
    poleSuwak(box, 'skala', o.scale, { min:.2, max:6 }, (v) => { o.scale = v; zmiana(); });
    poleSuwak(box, 'wysokość', o.height, { min:0, max:4 }, (v) => { o.height = v; zmiana(); });
    poleWybor(box, 'obrót', obrotDziala(o) ? 'stały kąt' : (o.faceCamera ? 'patrzy w kamerę' : 'kręci się w kółko'),
      ['stały kąt', 'kręci się w kółko', 'patrzy w kamerę'], (v) => {
        if (v === 'stały kąt') { o.bezObrotu = true; delete o.faceCamera; }
        else if (v === 'patrzy w kamerę') { o.faceCamera = true; delete o.bezObrotu; }
        else { delete o.bezObrotu; delete o.faceCamera; }
        zmiana();
      });
    poleSuwak(box, 'kąt [rad]', o.obrotY, { min:-3.15, max:3.15, krok:.01 }, (v) => { o.obrotY = v; zmiana(); });
    if (!obrotDziala(o))
      podpowiedz(box, o.faceCamera
        ? 'Ten znak patrzy w kamerę — silnik nadpisuje kąt co klatkę, więc suwak nic nie da. Przełącz na „stały kąt”, żeby ustawić go ręcznie.'
        : 'Ten znak kręci się w kółko (tak chodzą gwiazdki i medal), więc zadany kąt jest ignorowany. Przełącz na „stały kąt”, żeby go zatrzymać w wybranej pozycji.');
    poleKolor(box, 'poświata', o.glow, (v) => { o.glow = v; zmiana(); });
    poleKolor(box, 'pierścień', o.ringColor, (v) => { o.ringColor = v; zmiana(); });
    poleTak(box, 'znika po dotknięciu', o.absorb, (v) => { o.absorb = v; zmiana(); });
    poleTekst(box, 'wraca po [s]', o.respawn, (v) => { o.respawn = v; zmiana(); }, 'number');
    podpowiedz(box, 'Id trafia do aplikacji w zdarzeniu dotknięcia — po nim hub decyduje, którą minigrę odpalić (mapa ZNAK_GRY w Swiat.jsx).');
  }
  if (wybor.typ === 'budynek') {
    poleWybor(box, 'model', o.file, MODELE, (v) => { o.file = v; zmiana(); });
    poleSuwak(box, 'wysokość', o.wysokosc, { min:.5, max:12, krok:.1 }, (v) => { o.wysokosc = v; zmiana(); });
    poleSuwak(box, 'obrót [rad]', o.obrot, { min:-3.15, max:3.15, krok:.01 }, (v) => { o.obrot = v; zmiana(); });
    poleSuwak(box, 'kolizja r', o.promien, { min:.2, max:6, krok:.1 }, (v) => { o.promien = v; zmiana(); });
    poleSuwak(box, 'jasność', o.jasnosc, { min:.4, max:2.5 }, (v) => { o.jasnosc = v; zmiana(); });
    podpowiedz(box, 'Wysokość skaluje model tak, żeby miał tyle metrów — nie mnoży go. Obrót w radianach (Q i E przestawiają co 15°).');
  }
  if (wybor.typ === 'drzewo') {
    poleWybor(box, 'typ', o.typ, ['sosna','lisciaste'], (v) => { o.typ = v; zmiana(); });
    poleSuwak(box, 'skala', o.skala, { min:.3, max:3 }, (v) => { o.skala = v; zmiana(); });
    poleSuwak(box, 'obrót [rad]', o.obrot ?? 0, { min:-3.15, max:3.15, krok:.01 }, (v) => { o.obrot = v; zmiana(); });
    podpowiedz(box, 'Sosny i drzewa liściaste są bryłami obrotowymi tylko z grubsza — obrót zmienia, która gałąź patrzy na ścieżkę.');
  }
  if (wybor.typ === 'glaz') {
    poleSuwak(box, 'skala', o.skala, { min:.3, max:4 }, (v) => { o.skala = v; zmiana(); });
    poleSuwak(box, 'obrót [rad]', o.obrot ?? 0, { min:-3.15, max:3.15, krok:.01 }, (v) => { o.obrot = v; zmiana(); });
    podpowiedz(box, 'Bez ustawionego kąta głaz obraca się wzorem z własnego X — tak jak dotąd. Ruch suwakiem przejmuje nad nim kontrolę.');
  }
  if (wybor.typ === 'latarnia') {
    zapewnijWezly();
    poleSuwak(box, 'węzeł ścieżki', mapa.sciezkaWezly.wezelLatarni ?? 0,
      { min:0, max:Math.max(0, wezly().length - 1), krok:1 },
      (v) => { mapa.sciezkaWezly.wezelLatarni = Math.round(v); przeliczSciezke(); zmiana(); });
    podpowiedz(box, 'Do którego węzła ścieżki bohater dochodzi, gdy sam rusza do latarni. Indeks w wypalonej łamanej (`punktSciezki`) przelicza się sam.');
  }
  if (wybor.typ === 'sciezka') {
    const i = Number(wybor.idx);
    const rzad = document.createElement('div');
    rzad.className = 'przyciski-rzad';
    const dodaj = (gdzie, tekst) => {
      const b = document.createElement('button');
      b.textContent = tekst;
      b.onclick = () => wstawPunktSciezki(gdzie === 'przed' ? i : i + 1);
      rzad.appendChild(b);
    };
    dodaj('przed', '+ punkt przed');
    dodaj('po', '+ punkt po');
    box.appendChild(rzad);
    ustawieniaLuku(box);
    podpowiedz(box, 'Punkt „po” dokłada się w połowie odcinka do następnego; na końcu ścieżki przedłuża ją w tym samym kierunku. Ten sam efekt da klik w plusik na odcinku w trybie Ścieżka.');
  }
  if (wybor.typ === 'rzeka') {
    const [nr, rola] = String(wybor.idx).split(':');
    const k = mapa.rzeka.krzywe[nr];
    poleSuwak(box, 'gładkość', k.kroki ?? 12, { min:2, max:40, krok:1 }, (v) => { k.kroki = Math.round(v); zmiana(); });
    const rzad = document.createElement('div');
    rzad.className = 'przyciski-rzad';
    const dodajOdcinek = document.createElement('button');
    dodajOdcinek.textContent = '+ odcinek';
    dodajOdcinek.onclick = () => {
      const ost = mapa.rzeka.krzywe[mapa.rzeka.krzywe.length - 1];
      const kier = [ost.do[0] - ost.kontrola[0], ost.do[1] - ost.kontrola[1]];
      mapa.rzeka.krzywe.push({
        od: [...ost.do],
        kontrola: [zaokr(ost.do[0] + kier[0]), zaokr(ost.do[1] + kier[1])],
        do: [zaokr(ost.do[0] + kier[0] * 2.2), zaokr(ost.do[1] + kier[1] * 2.2)],
        kroki: 10,
      });
      wybor = { typ:'rzeka', idx: (mapa.rzeka.krzywe.length - 1) + ':do' };
      zmiana();
    };
    const usunOdcinek = document.createElement('button');
    usunOdcinek.className = 'groza';
    usunOdcinek.textContent = 'usuń odcinek';
    usunOdcinek.onclick = () => {
      if (mapa.rzeka.krzywe.length < 2) return;
      mapa.rzeka.krzywe.splice(Number(nr), 1);
      wybor = null;
      zmiana();
    };
    rzad.append(dodajOdcinek, usunOdcinek);
    box.appendChild(rzad);
    podpowiedz(box, rola === 'kontrola'
      ? 'Biała kropka to punkt sterujący — rzeka do niego nie dochodzi, tylko się w jego stronę wygina. Im dalej ją odciągniesz, tym ostrzejszy łuk.'
      : 'Niebieskie kropki to końce odcinka. Kolejny odcinek zaczyna się tam, gdzie kończy się poprzedni — przesuwając wspólny koniec, przesuwasz oba.');
  }
  if (wybor.typ === 'most') podpowiedz(box, 'Most obraca się sam wzdłuż drugiego odcinka ścieżki i tylko po nim da się przejść rzekę. Przesuwając most, przesuń też ścieżkę.');

  if (['znak','budynek','drzewo','glaz','sciezka'].includes(wybor.typ)) {
    const kasuj = document.createElement('button');
    kasuj.className = 'groza';
    kasuj.textContent = 'Usuń (Delete)';
    kasuj.onclick = usunWybor;
    box.appendChild(kasuj);
  }
}

/* ── Dodawanie i kasowanie ───────────────────────────────────────────────── */
function nowyZnak(x, z) {
  const file = $('#model').value || 'gwiazda';
  let n = 1;
  while ((mapa.znaki || []).some((s) => s.id === file + '-' + n)) n++;
  return { id:file + '-' + n, file, label:'Nowy znak', toast:'', pos:[x, z], scale:1, height:1.1,
           glow:0xFFD269, ringColor:0xFFE7B0, haloOpacity:.12, ringOpacity:.2, lightBase:0,
           metalness:0, roughness:.85, jasnosc:1.3, absorb:true, absorbLift:1.6, respawn:8 };
}

function dodajWPunkcie(x, z) {
  if (tryb === 'znak') {
    (mapa.znaki ||= []).push(nowyZnak(x, z));
    wybor = { typ:'znak', idx: mapa.znaki.length - 1 };
  } else if (tryb === 'budynek') {
    (mapa.budynki ||= []).push({ file: $('#model').value || 'hut2', pos:[x, z], wysokosc:3, obrot:0, promien:1.4, jasnosc:1.3 });
    wybor = { typ:'budynek', idx: mapa.budynki.length - 1 };
  } else if (tryb === 'drzewo') {
    (mapa.drzewa ||= []).push({ typ:'sosna', pos:[x, z], skala:1 });
    wybor = { typ:'drzewo', idx: mapa.drzewa.length - 1 };
  } else if (tryb === 'glaz') {
    (mapa.glazy ||= []).push({ pos:[x, z], skala:1 });
    wybor = { typ:'glaz', idx: mapa.glazy.length - 1 };
  } else if (tryb === 'sciezka') {
    zapewnijWezly();
    wezly().push([x, z]);
    wybor = { typ:'sciezka', idx: wezly().length - 1 };
    przeliczSciezke();
  } else {
    return false;
  }
  zapisz();
  rysuj();
  return true;
}

/**
 * Wstawia wierzcholek sciezki NA POZYCJI `i` (0 = przed pierwszym, dlugosc = na koncu).
 * W srodku ścieżki punkt ląduje w połowie odcinka, na końcach — przedłuża linię
 * w tym samym kierunku, żeby „extend" nie wymagał celowania myszą.
 */
function wstawPunktSciezki(i) {
  zapewnijWezly();
  const sc = mapa.sciezkaWezly.punkty;
  const sr = (a, b) => [zaokr((a[0] + b[0]) / 2), zaokr((a[1] + b[1]) / 2)];
  const przedluz = (a, b) => [zaokr(b[0] + (b[0] - a[0])), zaokr(b[1] + (b[1] - a[1]))];
  let nowy;
  if (sc.length === 0) nowy = [0, 0];
  else if (i <= 0) nowy = sc.length > 1 ? przedluz(sc[1], sc[0]) : [sc[0][0], sc[0][1] - 1];
  else if (i >= sc.length) nowy = sc.length > 1 ? przedluz(sc[sc.length - 2], sc[sc.length - 1])
                                                : [sc[0][0], sc[0][1] + 1];
  else nowy = sr(sc[i - 1], sc[i]);
  sc.splice(i, 0, nowy);
  if (mapa.sciezkaWezly.wezelLatarni >= i) mapa.sciezkaWezly.wezelLatarni++;
  wybor = { typ:'sciezka', idx: i };
  przeliczSciezke();
  zapisz();
  rysuj();
}

function usunWybor() {
  if (!wybor) return;
  if (wybor.typ === 'sciezka') {
    const i = Number(wybor.idx);
    wezly().splice(i, 1);
    if (mapa.sciezkaWezly.wezelLatarni > i) mapa.sciezkaWezly.wezelLatarni--;
    wybor = null;
    przeliczSciezke();
    zapisz();
    rysuj();
    return;
  }
  const tablice = { znak:'znaki', budynek:'budynki', drzewo:'drzewa', glaz:'glazy' };
  const nazwa = tablice[wybor.typ];
  if (!nazwa) return;
  mapa[nazwa].splice(Number(wybor.idx), 1);
  wybor = null;
  zapisz();
  rysuj();
}

/**
 * Sąsiednie odcinki rzeki dzielą wspólny koniec. Gdyby każdy trzymał własną
 * kopię współrzędnych, przeciągnięcie jednego zostawiałoby w wodzie dziurę —
 * więc po ruchu końcem dosuwamy sąsiada.
 */
function sklejRzeke(idx) {
  const [nr, rola] = idx.split(':');
  const i = Number(nr);
  const K = mapa.rzeka?.krzywe || [];
  if (rola === 'do' && K[i + 1]) K[i + 1].od = [...K[i].do];
  if (rola === 'od' && K[i - 1]) K[i - 1].do = [...K[i].od];
}

/* ── Mysz na planie ──────────────────────────────────────────────────────── */
function doSwiata(ev) {
  const pkt = plan.createSVGPoint();
  pkt.x = ev.clientX;
  pkt.y = ev.clientY;
  const m = pkt.matrixTransform(plan.getScreenCTM().inverse());
  return [zaokr(m.x), zaokr(m.y)];
}

let ciagniecie = null;

plan.addEventListener('pointerdown', (ev) => {
  if (ev.button !== 0 || spacja) return;      // prawy/środkowy i spacja = przesuwanie widoku
  const cel = ev.target.dataset && ev.target.dataset.typ ? ev.target : null;
  const [x, z] = doSwiata(ev);
  if (cel && cel.dataset.typ === 'wstaw-sciezke') { wstawPunktSciezki(Number(cel.dataset.idx)); return; }

  if (cel && (cel.dataset.typ === 'uchwyt-obrot' || cel.dataset.typ === 'uchwyt-skala')) {
    const o = obiektWyboru();
    if (!o) return;
    const bok = Math.hypot(x - o.pos[0], z - o.pos[1]) || 1;
    ciagniecie = {
      uchwyt: cel.dataset.typ === 'uchwyt-obrot' ? 'obrot' : 'skala',
      o, bazaDystans: bok, bazaSkala: o[POLE_SKALI[wybor.typ]] ?? 1,
    };
    plan.setPointerCapture(ev.pointerId);
    return;
  }

  if (cel) {
    wybor = { typ: cel.dataset.typ, idx: cel.dataset.idx };
    const o = obiektWyboru();
    if (o && o.pos) {
      ciagniecie = { pos: o.pos, dx: o.pos[0] - x, dz: o.pos[1] - z };
      plan.setPointerCapture(ev.pointerId);
    }
    rysuj();
    return;
  }
  if (!dodajWPunkcie(x, z)) {
    // W trybie „Wybierz" puste tło nie ma co dodawać — więc ciągnięcie po nim
    // przesuwa mapę. To najczęstszy odruch i szkoda kazać komuś szukać spacji.
    wybor = null;
    rysuj();
    panowanie = { x: ev.clientX, y: ev.clientY, start: { ...widok } };
    plan.setPointerCapture(ev.pointerId);
    plan.classList.add('lapa-trzyma');
  }
});

plan.addEventListener('pointermove', (ev) => {
  if (!ciagniecie) return;
  const [x, z] = doSwiata(ev);
  const o = ciagniecie.o;

  if (ciagniecie.uchwyt === 'obrot') {
    const kat = zaokr(Math.atan2(x - o.pos[0], z - o.pos[1]));
    o[POLE_OBROTU[wybor.typ] || 'obrot'] = kat;
    rysuj();
    return;
  }
  if (ciagniecie.uchwyt === 'skala') {
    const d = Math.hypot(x - o.pos[0], z - o.pos[1]);
    const nowa = Math.max(.15, zaokr(ciagniecie.bazaSkala * (d / ciagniecie.bazaDystans)));
    o[POLE_SKALI[wybor.typ]] = nowa;
    rysuj();
    return;
  }

  ciagniecie.pos[0] = zaokr(x + ciagniecie.dx);
  ciagniecie.pos[1] = zaokr(z + ciagniecie.dz);
  if (wybor && wybor.typ === 'sciezka') przeliczSciezke();
  if (wybor && wybor.typ === 'rzeka') sklejRzeke(String(wybor.idx));
  rysuj();
});

plan.addEventListener('pointerup', () => {
  if (!ciagniecie) return;
  ciagniecie = null;
  zapisz();
});

/* ── Widok: zoom i przesuwanie ────────────────────────────────────────────
   Wszystko rysujemy w METRACH ŚWIATA, a kadrowaniem zajmuje się `viewBox`.
   Dzięki temu zoom i przesuwanie nie dotykają ani jednej współrzędnej obiektu —
   zmienia się tylko okno, przez które patrzymy.

   Przesuwanie idzie PRAWYM albo ŚRODKOWYM przyciskiem, ewentualnie ze spacją.
   Lewy jest zajęty: w trybach dodawania klik w puste miejsce stawia obiekt,
   więc gdyby przesuwał mapę, nie dałoby się niczego postawić.                */
const WIDOK_STARTOWY = { x:-19, y:-19, w:38 };
let widok = { ...WIDOK_STARTOWY };
let spacja = false;

function zastosujWidok() {
  plan.setAttribute('viewBox', `${widok.x} ${widok.y} ${widok.w} ${widok.w}`);
}

/** Ile metrów świata przypada na piksel ekranu (viewBox jest kwadratowy, meet). */
function metryNaPiksel() {
  const s = Math.min(plan.clientWidth / widok.w, plan.clientHeight / widok.w);
  return 1 / (s || 1);
}

plan.addEventListener('wheel', (ev) => {
  ev.preventDefault();
  const [x, z] = doSwiata(ev);
  const k = ev.deltaY > 0 ? 1.12 : 1 / 1.12;
  const nowa = Math.min(120, Math.max(4, widok.w * k));
  widok = { x: x - (x - widok.x) * (nowa / widok.w), y: z - (z - widok.y) * (nowa / widok.w), w: nowa };
  zastosujWidok();
}, { passive: false });

plan.addEventListener('contextmenu', (ev) => ev.preventDefault());

let panowanie = null;

plan.addEventListener('pointerdown', (ev) => {
  if (ev.button !== 1 && ev.button !== 2 && !spacja) return;
  ev.preventDefault();
  ev.stopPropagation();
  panowanie = { x: ev.clientX, y: ev.clientY, start: { ...widok } };
  plan.setPointerCapture(ev.pointerId);
  plan.classList.add('lapa-trzyma');
}, true);   // faza przechwytywania — zanim zadziała zaznaczanie obiektów

plan.addEventListener('pointermove', (ev) => {
  if (!panowanie) return;
  const m = metryNaPiksel();
  widok.x = panowanie.start.x - (ev.clientX - panowanie.x) * m;
  widok.y = panowanie.start.y - (ev.clientY - panowanie.y) * m;
  zastosujWidok();
}, true);

function koniecPanowania() {
  if (!panowanie) return;
  panowanie = null;
  plan.classList.remove('lapa-trzyma');
}
plan.addEventListener('pointerup', koniecPanowania, true);
plan.addEventListener('pointercancel', koniecPanowania, true);

document.addEventListener('keydown', (ev) => {
  if (ev.code === 'Space' && !['INPUT','SELECT','TEXTAREA'].includes(ev.target.tagName)) {
    ev.preventDefault();
    spacja = true;
    plan.classList.add('lapa');
  }
});
document.addEventListener('keyup', (ev) => {
  if (ev.code === 'Space') { spacja = false; plan.classList.remove('lapa'); }
});

/* ── Klawiatura ──────────────────────────────────────────────────────────── */
document.addEventListener('keydown', (ev) => {
  if (['INPUT','SELECT','TEXTAREA'].includes(ev.target.tagName)) return;
  if (ev.ctrlKey && ev.key.toLowerCase() === 'z') { ev.preventDefault(); cofnij(); return; }
  if (ev.key === 'Delete' || ev.key === 'Backspace') { usunWybor(); return; }
  const o = obiektWyboru();
  if (!o) return;
  if (ev.key === 'q' || ev.key === 'e') {
    const polo = POLE_OBROTU[wybor.typ];
    if (!polo) return;
    const d = (ev.key === 'q' ? -1 : 1) * Math.PI / 12;
    o[polo] = zaokr((o[polo] ?? 0) + d);
    zapisz(); rysuj(); return;
  }
  if (ev.key === '[' || ev.key === ']') {
    const d = (ev.key === '[' ? -1 : 1) * .05;
    if ('skala' in o) o.skala = zaokr((o.skala ?? 1) + d);
    else if ('scale' in o) o.scale = zaokr((o.scale ?? 1) + d);
    zapisz(); rysuj(); return;
  }
  const ruch = { ArrowLeft:[-1,0], ArrowRight:[1,0], ArrowUp:[0,-1], ArrowDown:[0,1] }[ev.key];
  if (ruch && o.pos) {
    ev.preventDefault();
    const krok = ev.shiftKey ? .5 : .1;
    o.pos[0] = zaokr(o.pos[0] + ruch[0] * krok);
    o.pos[1] = zaokr(o.pos[1] + ruch[1] * krok);
    if (wybor.typ === 'sciezka') przeliczSciezke();
    zapisz(); rysuj();
  }
});

/* ── Podpięcie interfejsu ────────────────────────────────────────────────── */
$('#model').innerHTML = MODELE.map((m) => `<option>${m}</option>`).join('');
$('#btn-pobierz').onclick = pobierz;
$('#btn-zapisz').onclick = () => zapiszWProjekcie();
$('#auto').onchange = () => { if ($('#auto').checked) zapiszWProjekcie({ cicho: true }); };
$('#btn-cofnij').onclick = cofnij;
$('#btn-oryginal').onclick = () => wczytaj({ zSerwera: true });
$('#btn-odswiez').onclick = odswiezPodglad;
$('#btn-widok').onclick = () => { widok = { ...WIDOK_STARTOWY }; zastosujWidok(); };

$('#btn-plik').onclick = () => $('#plik').click();
$('#plik').onchange = async (ev) => {
  const f = ev.target.files[0];
  if (f) ustaw(JSON.parse(await f.text()), 'plik ' + f.name);
};

rysujNarzedzia();
wczytaj();
</script>
