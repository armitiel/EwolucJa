/**
 * Pobierz losowy item z biblioteki dla danego (kind, profile), wykluczając listę ID.
 * Fallback: jeśli żaden item nie pasuje exclude, zwróć losowy z całej puli (kind+profile).
 * @param {string} kind 'task' | 'hint' | 'artifact'
 * @param {string} profile 'DT' | 'EM' | 'ST' | 'KR' | 'LD' | 'MD'
 * @param {Set<string>|Array<string>} excludeIds — id które juz uzyte (zeby nie powtarzac)
 * @returns {object|null}
 */
export function pickTaskForGenerator(kind, profile, excludeIds = []) {
  const exclude = excludeIds instanceof Set ? excludeIds : new Set(excludeIds);
  const all = MENTOR_TASK_LIBRARY.filter((it) => it.kind === kind && it.profile === profile);
  if (!all.length) return null;
  const fresh = all.filter((it) => !exclude.has(it.id));
  const pool = fresh.length > 0 ? fresh : all;
  return pool[Math.floor(Math.random() * pool.length)];
}

/** Liczniki dla statystyk / debugowania. */
export function libraryStats() {
  const counts = {};
  for (const it of MENTOR_TASK_LIBRARY) {
    const key = `${it.profile}-${it.kind}`;
    counts[key] = (counts[key] || 0) + 1;
  }
  return { total: MENTOR_TASK_LIBRARY.length, per: counts };
}
