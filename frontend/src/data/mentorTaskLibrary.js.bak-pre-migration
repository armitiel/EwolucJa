  { id: "ST-HINT-004", profile: "ST", kind: "hint", title: "Porządek pomaga myśleć", body: "Gdy wszystko leży na swoim miejscu, łatwiej się myśli. Posprzątaj jedno małe miejsce i zobacz, jak się czujesz.", points_reward: 0, competency_focus: ["ST"], tags: ["motywacja"] },
  { id: "ST-HINT-005", profile: "ST", kind: "hint", title: "Każdy plan można zmienić", body: "Pamiętaj: jeśli plan nie wyszedł, to nie porażka. Mistrz Map zawsze może narysować nową mapę.", points_reward: 0, competency_focus: ["ST"], tags: ["motywacja"] },
  { id: "ST-ART-001", profile: "ST", kind: "artifact", title: "Złoty Cyrkiel", body: "Magiczne narzędzie kreślarza. Pomaga rysować idealne plany i mapy. Im więcej map narysujesz, tym bardziej lśni.", points_reward: 5, competency_focus: ["ST"], tags: ["artefakt"] },
  { id: "ST-ART-002", profile: "ST", kind: "artifact", title: "Klepsydra Mądrości", body: "Piasek w niej sypie się wolniej, gdy myślisz spokojnie. Pomaga znaleźć czas na zaplanowanie ważnych rzeczy.", points_reward: 5, competency_focus: ["ST"], tags: ["artefakt"] },
  { id: "ST-ART-003", profile: "ST", kind: "artifact", title: "Mapa Wszystkich Dróg", body: "Pergamin, na którym pojawiają się ścieżki do każdego celu, jaki sobie wyznaczysz. Wystarczy zapisać marzenie.", points_reward: 5, competency_focus: ["ST"], tags: ["artefakt"] },
  { id: "ST-ART-004", profile: "ST", kind: "artifact", title: "Liczydło Gwiazd", body: "Każda koralka to jedna gwiazda. Im więcej rzeczy policzysz na świecie, tym więcej gwiazd zapala się w liczydle.", points_reward: 5, competency_focus: ["ST"], tags: ["artefakt"] },
  { id: "ST-ART-005", profile: "ST", kind: "artifact", title: "Korona Stratega", body: "Lekka korona z gwiezdnych nici. Gdy ją nosisz, łatwiej widzisz kolejne kroki w każdej misji.", points_reward: 5, competency_focus: ["ST"], tags: ["artefakt"] },

  // ═══════════════════════════════════════════════════════════════
  // KREATOR (KR) — Kreatywność
  // ═══════════════════════════════════════════════════════════════
  { id: "KR-TASK-001", profile: "KR", kind: "task", title: "Stwór z chmur", body: "Spójrz w niebo i znajdź chmurę. Wyobraź sobie, jakim jest stworem albo postacią. Narysuj go na kartce z imieniem. Dolina Selfie kocha takie historie.", points_reward: 25, competency_focus: ["KR", "DT"], proof_hint: "Zdjęcie rysunku z imieniem stwora.", tags: ["wyobraźnia", "natura"] },
  { id: "KR-TASK-002", profile: "KR", kind: "task", title: "Nowa końcówka bajki", body: "Pomyśl o ulubionej bajce i wymyśl jej nowe zakończenie. Może bohater wybierze coś innego? Opowiedz lub zapisz w 3-4 zdaniach.", points_reward: 30, competency_focus: ["KR", "ST"], proof_hint: "Wpisz nowe zakończenie.", tags: ["historie", "wyobraźnia"] },
  { id: "KR-TASK-003", profile: "KR", kind: "task", title: "Wynalazek z kuchni", body: "Z plastikowej butelki, słomki, gumki i innych drobiazgów wymyśl nowy przedmiot. Może to być rakieta dla mrówek, kapelusz dla łyżki. Zrób go i nadaj nazwę.", points_reward: 35, competency_focus: ["KR", "ST"], proof_hint: "Zdjęcie wynalazku i nazwa.", tags: ["tworzenie", "wyobraźnia"] },
  { id: "KR-TASK-004", profile: "KR", kind: "task", title: "Portret z kredek", body: "Narysuj portret kogoś z rodziny, ale nie zwykły, tylko taki magiczny: z gwiazdami w oczach, w koronie z liści, jako kosmitę. Pokaż tej osobie.", points_reward: 30, competency_focus: ["KR", "EM"], proof_hint: "Zdjęcie portretu.", tags: ["rysunek", "rodzina"] },
  { id: "KR-TASK-005", profile: "KR", kind: "task", title: "Piosenka o dniu", body: "Wymyśl krótką piosenkę o tym, jak Ci minął dzień. Może być na melodię, którą znasz. 4 linijki wystarczą. Zaśpiewaj komuś.", points_reward: 25, competency_focus: ["KR", "EM"], proof_hint: "Wpisz tekst albo nagraj krótkie nagranie.", tags: ["muzyka", "tworzenie"] },
  { id: "KR-TASK-006", profile: "KR", kind: "task", title: "Maska z papieru", body: "Wytnij z kartki kształt maski na twarz (z pomocą dorosłego). Pomaluj kredkami albo flamastrami: zwierzę, potwora, superbohatera. Załóż i przejrzyj się w lustrze.", points_reward: 35, competency_focus: ["KR", "LD"], proof_hint: "Zdjęcie w masce.", tags: ["tworzenie", "zabawa"] },
  { id: "KR-TASK-007", profile: "KR", kind: "task", title: "A gdyby zwierzęta mówiły?", body: "Wyobraź sobie, że Twoje ulubione zwierzę umie mówić. O czym by Ci opowiedziało? Zapisz lub narysuj jego pierwsze 3 zdania do Ciebie.", points_reward: 25, competency_focus: ["KR", "EM"], proof_hint: "Trzy zdania zwierzęcia.", tags: ["wyobraźnia", "historie"] },
  { id: "KR-TASK-008", profile: "KR", kind: "task", title: "Pomnik z poduszek", body: "Zbuduj w pokoju coś niezwykłego: zamek z poduszek, fort z kocy, statek z krzeseł. Tkacz Snów buduje światy z tego, co ma pod ręką.", points_reward: 30, competency_focus: ["KR", "ST"], proof_hint: "Zdjęcie budowli.", tags: ["budowanie", "zabawa"] },
  { id: "KR-TASK-009", profile: "KR", kind: "task", title: "Słownik wymyślonych słów", body: "Wymyśl 3 nowe słowa, których nikt nie zna. Każde z nich powinno coś znaczyć. Np. „murloflik\" - to lekkie pierdzenie kota. Zapisz słowo i znaczenie.", points_reward: 30, competency_focus: ["KR", "DT"], proof_hint: "Trzy słowa z definicjami.", tags: ["słowa", "wyobraźnia"] },
  { id: "KR-TASK-010", profile: "KR", kind: "task", title: "Tańcząca opowieść", body: "Włącz dowolną muzykę i tańcz przez 2 minuty, opowiadając ciałem historię: jesteś drzewem na wietrze, potem fala morska, potem rakieta. Niech ktoś zgadnie co tańczysz.", points_reward: 25, competency_focus: ["KR", "LD"], proof_hint: "Napisz kto patrzył i co zgadł.", tags: ["taniec", "wyobraźnia"] },
  { id: "KR-HINT-001", profile: "KR", kind: "hint", title: "A gdyby...?", body: "Dolina Selfie szepcze: największe wynalazki zaczęły się od pytania „a gdyby?\". Zapytaj dziś o coś niemożliwego.", points_reward: 0, competency_focus: ["KR"], tags: ["motywacja"] },
  { id: "KR-HINT-002", profile: "KR", kind: "hint", title: "Nie ma złych pomysłów", body: "Pamiętaj: każdy pomysł jest dobry na początku. Zapisz pierwszy, jaki Ci przyjdzie do głowy, nawet jeśli wydaje się dziwny.", points_reward: 0, competency_focus: ["KR"], tags: ["motywacja"] },
  { id: "KR-HINT-003", profile: "KR", kind: "hint", title: "Sztuka mieszka wszędzie", body: "Nawet w kawałku papieru czy kamyku siedzi historia. Wybierz coś prostego i zobacz, co z tego zrobisz.", points_reward: 0, competency_focus: ["KR"], tags: ["motywacja"] },
  { id: "KR-HINT-004", profile: "KR", kind: "hint", title: "Twoje ręce wiedzą", body: "Czasem nie wiesz, co chcesz zrobić, dopóki ręce nie zaczną. Weź kredkę albo papier i po prostu zacznij.", points_reward: 0, competency_focus: ["KR"], tags: ["motywacja"] },
  { id: "KR-HINT-005", profile: "KR", kind: "hint", title: "Bałagan to początek piękna", body: "Tkacz Snów wie: każde dzieło zaczyna się od bałaganu. Pozwól sobie najpierw stworzyć coś niezgrabnego, a potem to zmienisz.", points_reward: 0, competency_focus: ["KR"], tags: ["motywacja"] },
  { id: "KR-ART-001", profile: "KR", kind: "artifact", title: "Pędzel Tkacza Snów", body: "Magiczny pędzel maluje to, co sobie wyobrazisz, nawet w powietrzu. Im więcej tworzysz, tym żywsze są kolory.", points_reward: 5, competency_focus: ["KR"], tags: ["artefakt"] },
  { id: "KR-ART-002", profile: "KR", kind: "artifact", title: "Nić Wyobraźni", body: "Cienka srebrna nić, która łączy najbardziej szalone pomysły w jedną historię. Nigdy się nie kończy.", points_reward: 5, competency_focus: ["KR"], tags: ["artefakt"] },
  { id: "KR-ART-003", profile: "KR", kind: "artifact", title: "Kałamarz Nowych Słów", body: "Atrament w tym kałamarzu nigdy nie wysycha, a pióro samo zapisuje wymyślone przez Ciebie słowa.", points_reward: 5, competency_focus: ["KR"], tags: ["artefakt"] },
  { id: "KR-ART-004", profile: "KR", kind: "artifact", title: "Kapelusz Wynalazcy", body: "Wełniany kapelusz z gwiazdami w środku. Gdy go założysz, pomysły same wpadają do głowy szybciej niż uciekają.", points_reward: 5, competency_focus: ["KR"], tags: ["artefakt"] },
  { id: "KR-ART-005", profile: "KR", kind: "artifact", title: "Lustro Drugiej Strony", body: "W tym lustrze widzisz świat odwrócony do góry nogami. Pomaga wymyślać rzeczy, których nikt jeszcze nie widział.", points_reward: 5, competency_focus: ["KR"], tags: ["artefakt"] },

  // ═══════════════════════════════════════════════════════════════
  // LIDER (LD) — Odwaga
  // ═══════════════════════════════════════════════════════════════
  { id: "LD-TASK-001", profile: "LD", kind: "task", title: "Ja zacznę pierwszy", body: "Zaproponuj komuś z rodziny grę, zabawę albo wspólną czynność. To Ty wybierasz co i kiedy. Przystań Współpracy lubi takich, którzy zaczynają.", points_reward: 25, competency_focus: ["LD", "EM"], proof_hint: "Napisz co zaproponowałeś i komu.", tags: ["inicjatywa", "rodzina"] },
  { id: "LD-TASK-002", profile: "LD", kind: "task", title: "Nowa rzecz dnia", body: "Zrób dziś coś, czego nigdy wcześniej nie robiłeś. Może spróbujesz nowego smaku, zaśpiewasz głośno, powiesz nową frazę. Gwardzista nie boi się pierwszego razu.", points_reward: 30, competency_focus: ["LD", "DT"], proof_hint: "Napisz co to było.", tags: ["odwaga", "nowe"] },
  { id: "LD-TASK-003", profile: "LD", kind: "task", title: "Zachęć kogoś", body: "Znajdź kogoś, kto wydaje się smutny albo niepewny. Powiedz mu coś dobrego: „dasz radę\", „masz fajny pomysł\", „jesteś świetny w tym\". Patrz mu w oczy.", points_reward: 30, competency_focus: ["LD", "EM"], proof_hint: "Komu i co powiedziałeś.", tags: ["zachęta", "życzliwość"] },
  { id: "LD-TASK-004", profile: "LD", kind: "task", title: "Mów głośno i jasno", body: "Stań przed lustrem i powiedz głośno: „jestem Gwardzistą, dam radę!\" Powtórz 3 razy z różną głośnością. Głos to siła.", points_reward: 20, competency_focus: ["LD", "EM"], proof_hint: "Nagranie krótkie albo opis jak Ci poszło.", tags: ["odwaga", "głos"] },
  { id: "LD-TASK-005", profile: "LD", kind: "task", title: "Decyzja wieczoru", body: "Dziś to Ty wybierasz: jaką bajkę oglądamy, jaką grę gramy, co jemy na podwieczorek. Powiedz spokojnie i pewnie. Lider podejmuje decyzje.", points_reward: 25, competency_focus: ["LD", "ST"], proof_hint: "Napisz jaką decyzję podjąłeś.", tags: ["decyzje", "inicjatywa"] },
  { id: "LD-TASK-006", profile: "LD", kind: "task", title: "Wstać wcześniej niż wczoraj", body: "Spróbuj wstać 10 minut wcześniej niż zwykle. Wstań sam, zanim ktoś Cię obudzi. Małe wyzwanie, wielka satysfakcja.", points_reward: 30, competency_focus: ["LD", "ST"], proof_hint: "Napisz o której wstałeś i czy sam.", tags: ["odwaga", "rutyna"] },
  { id: "LD-TASK-007", profile: "LD", kind: "task", title: "Organizator zabawy", body: "Wymyśl grę albo zabawę dla dwóch lub więcej osób w domu. Wytłumacz zasady, rozpocznij i prowadź zabawę. Ty jesteś kapitanem.", points_reward: 35, competency_focus: ["LD", "KR"], proof_hint: "Opisz grę i kto się bawił.", tags: ["inicjatywa", "rodzina"] },
  { id: "LD-TASK-008", profile: "LD", kind: "task", title: "Trudna rozmowa", body: "Jeśli coś Cię od jakiegoś czasu martwi albo złości, powiedz to dorosłemu spokojnie. Nie krzycz, nie obwiniaj. Zacznij od „czuję, że...\" To wymaga odwagi.", points_reward: 35, competency_focus: ["LD", "EM"], proof_hint: "Krótko: o czym rozmawiałeś.", tags: ["odwaga", "rozmowa"] },
  { id: "LD-TASK-009", profile: "LD", kind: "task", title: "Pierwszy krok w nieznane", body: "Zrób coś, co wydaje Ci się trochę trudne: zadzwoń do babci sam, zapytaj sąsiada o coś (z rodzicem obok), zamów coś w kawiarni. Gwardzista próbuje.", points_reward: 35, competency_focus: ["LD", "MD"], proof_hint: "Co zrobiłeś po raz pierwszy.", tags: ["odwaga", "samodzielność"] },
  { id: "LD-TASK-010", profile: "LD", kind: "task", title: "Pochwała głośno", body: "Gdy ktoś dziś zrobi coś dobrego, powiedz to głośno: „super pomysł!\", „świetnie się starałeś!\". Lider zauważa innych i mówi to wprost.", points_reward: 25, competency_focus: ["LD", "EM"], proof_hint: "Kogo pochwaliłeś i za co.", tags: ["zachęta", "życzliwość"] },
  { id: "LD-HINT-001", profile: "LD", kind: "hint", title: "Pierwszy krok jest najtrudniejszy", body: "Przystań Współpracy szepcze: gdy zrobisz pierwszy krok, reszta sama się ułoży. Spróbuj.", points_reward: 0, competency_focus: ["LD"], tags: ["motywacja"] },
  { id: "LD-HINT-002", profile: "LD", kind: "hint", title: "Strach to nie wróg", body: "Każdy Gwardzista czasem się boi. Odwaga to nie brak strachu, tylko robienie czegoś mimo niego.", points_reward: 0, competency_focus: ["LD"], tags: ["motywacja"] },
  { id: "LD-HINT-003", profile: "LD", kind: "hint", title: "Twój głos się liczy", body: "Powiedz głośno, czego chcesz. Inni nie zgadną, jeśli Ty nie powiesz. Mów spokojnie i jasno.", points_reward: 0, competency_focus: ["LD"], tags: ["motywacja"] },
  { id: "LD-HINT-004", profile: "LD", kind: "hint", title: "Próbuj, nawet jeśli się nie uda", body: "Najgorsze co możesz zrobić, to nie spróbować. Spróbuj raz, dwa, trzy. Każda próba to mała wygrana.", points_reward: 0, competency_focus: ["LD"], tags: ["motywacja"] },
  { id: "LD-HINT-005", profile: "LD", kind: "hint", title: "Inni pójdą za Tobą", body: "Gdy zrobisz coś z entuzjazmem, inni zaczną Cię naśladować. Nawet jednym małym uśmiechem możesz pociągnąć drużynę.", points_reward: 0, competency_focus: ["LD"], tags: ["motywacja"] },
  { id: "LD-ART-001", profile: "LD", kind: "artifact", title: "Tarcza Gwardzisty", body: "Lekka tarcza, która chroni przed strachem. Im więcej razy spróbujesz czegoś nowego, tym jaśniej lśni jej krawędź.", points_reward: 5, competency_focus: ["LD"], tags: ["artefakt"] },
  { id: "LD-ART-002", profile: "LD", kind: "artifact", title: "Płomień Pierwszego Kroku", body: "Mała iskra, która zapala się, gdy ktoś rozpoczyna coś nowego. Pomaga przezwyciężyć moment niepewności.", points_reward: 5, competency_focus: ["LD"], tags: ["artefakt"] },
  { id: "LD-ART-003", profile: "LD", kind: "artifact", title: "Róg Wezwania", body: "Stary róg, który słyszą tylko przyjaciele. Pomaga zebrać drużynę, gdy potrzebujesz wspólnej zabawy.", points_reward: 5, competency_focus: ["LD"], tags: ["artefakt"] },
  { id: "LD-ART-004", profile: "LD", kind: "artifact", title: "Sztandar Drużyny", body: "Kolorowy sztandar, na którym pojawiają się imiona wszystkich, których kiedyś zachęciłeś. Niesiesz go z dumą.", points_reward: 5, competency_focus: ["LD"], tags: ["artefakt"] },
  { id: "LD-ART-005", profile: "LD", kind: "artifact", title: "Buty Siedmiomilowe", body: "Wygodne buty, w których trudne kroki wydają się łatwiejsze. Każdy pierwszy raz przybliżają o krok bliżej do celu.", points_reward: 5, competency_focus: ["LD"], tags: ["artefakt"] },

  // ═══════════════════════════════════════════════════════════════
  // MEDIATOR (MD) — Skupienie
  // ═══════════════════════════════════════════════════════════════
  { id: "MD-TASK-001", profile: "MD", kind: "task", title: "Pięć minut ciszy", body: "Usiądź wygodnie i nic nie rób przez 5 minut. Po prostu oddychaj. Możesz zamknąć oczy. Wyspa Talentów docenia spokój.", points_reward: 25, competency_focus: ["MD", "EM"], proof_hint: "Napisz jak się czułeś po cichym czasie.", tags: ["skupienie", "spokój"] },
  { id: "MD-TASK-002", profile: "MD", kind: "task", title: "Most między dwoma", body: "Jeśli widzisz, że ktoś się kłóci albo ma inne zdanie, spróbuj znaleźć coś wspólnego między nimi. Powiedz na głos: „obaj chcecie tego samego, bo...\". Strażnik Mostu łączy.", points_reward: 35, competency_focus: ["MD", "EM"], proof_hint: "Opisz sytuację i co powiedziałeś.", tags: ["mediacja", "kompromis"] },
  { id: "MD-TASK-003", profile: "MD", kind: "task", title: "Jedna rzecz, pełna uwaga", body: "Wybierz jedną czynność (jedzenie, rysowanie, czytanie) i rób ją przez 10 minut bez przerywania. Bez telewizora, bez rozmów. Tylko Ty i to.", points_reward: 30, competency_focus: ["MD", "DT"], proof_hint: "Co robiłeś i jak długo wytrzymałeś.", tags: ["skupienie", "uważność"] },
  { id: "MD-TASK-004", profile: "MD", kind: "task", title: "Słuchaj bez mówienia", body: "Poproś kogoś z domu, by opowiedział Ci coś przez minutę. Twoim zadaniem jest tylko słuchać, bez przerywania. Potem powtórz, co usłyszałeś.", points_reward: 25, competency_focus: ["MD", "EM"], proof_hint: "Kogo słuchałeś i krótko o czym mówił.", tags: ["słuchanie", "skupienie"] },
  { id: "MD-TASK-005", profile: "MD", kind: "task", title: "Dwa pomysły, jedno rozwiązanie", body: "Jeśli dziś chcesz jednej rzeczy, a ktoś inny czegoś innego, spróbuj wymyślić trzeci pomysł, który zadowoli oboje. „A może najpierw to, potem to?\"", points_reward: 35, competency_focus: ["MD", "ST"], proof_hint: "Opisz sytuację i Twój kompromisowy pomysł.", tags: ["kompromis", "myślenie"] },
  { id: "MD-TASK-006", profile: "MD", kind: "task", title: "Mapa oddechu", body: "Połóż rękę na brzuchu. Oddychaj wolno: wdech 4 sekundy, wydech 4 sekundy. Zrób tak 10 razy. Poczuj jak brzuch unosi się i opada.", points_reward: 20, competency_focus: ["MD", "EM"], proof_hint: "Napisz jak czułeś się po oddychaniu.", tags: ["spokój", "uważność"] },
  { id: "MD-TASK-007", profile: "MD", kind: "task", title: "Łańcuch dobrych pytań", body: "Zamiast spierać się z kimś, zadaj 3 pytania: „dlaczego tak myślisz?\", „a co byłoby, gdyby...?\", „czego potrzebujesz?\". Zobacz co odkryjesz.", points_reward: 30, competency_focus: ["MD", "DT"], proof_hint: "Z kim rozmawiałeś i czego się dowiedziałeś.", tags: ["mediacja", "pytania"] },
  { id: "MD-TASK-008", profile: "MD", kind: "task", title: "Spacer bez słów", body: "Pójdź na 10-minutowy spacer z dorosłym, w ciszy. Nie rozmawiajcie. Tylko patrzcie, słuchajcie. Powiedz potem, co zauważyłeś.", points_reward: 30, competency_focus: ["MD", "DT"], proof_hint: "Co zauważyłeś podczas cichego spaceru.", tags: ["skupienie", "natura"] },
