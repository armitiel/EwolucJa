            {
              "id": "d",
              "text": "Biorę mapę i idę z nią na koniec pomostu.",
              "traits": { "odwaga": 3, "wytrwalosc": 1, "tworzenie": 1 },
              "grant": "znak-kroku",
              "reaction": "Deski skrzypią. Woda pod nimi robi się jaśniejsza."
