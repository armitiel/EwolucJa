              "grant": "latarenka",
              "reaction": "Odbicie w wodzie świeci mocniej niż sama latarnia."
            },
            {
              "id": "c",
              "text": "Nucę jej coś cicho.",
              "traits": { "tworzenie": 3, "wspolpraca": 1, "wytrwalosc": 1 },
              "grant": "pioro-wiatru",
              "reaction": "Płomień kołysze się w rytm. Naprawdę."
