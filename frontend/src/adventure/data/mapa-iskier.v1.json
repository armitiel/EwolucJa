            { "id": "zloto", "text": "Złote jak latarnia", "color": "#F5C45E", "traits": { "odwaga": 1 }, "grant": "szal-swiatla", "reaction": "Latarnie na pomoście zapalają się jedna po drugiej." },
            { "id": "zielen", "text": "Zielone jak mech", "color": "#7BD48F", "traits": { "wspolpraca": 1 }, "grant": "plaszcz-mchu", "reaction": "Między deskami wyrasta mały, świecący mech." },
            { "id": "fiolet", "text": "Fioletowe jak wieczór", "color": "#B58CF0", "traits": { "tworzenie": 1 }, "grant": "naramiennik", "reaction": "Niebo nad przystanią ciemnieje w dobry sposób." }
